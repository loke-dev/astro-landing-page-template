{
  "name": "astro-landing-page-template",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "^22.22.3 || ^24.16.0 || >=26.3.0"
  },
  "scripts": {
    "dev": "astro dev --port 4000",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint --cache .",
    "format": "prettier --write \"src/**/*.{ts,tsx,astro,css,json}\" README.md package.json astro.config.ts eslint.config.js tsconfig.json worker.js wrangler.jsonc pnpm-workspace.yaml .prettierrc.json",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,astro,css,json}\" README.md package.json astro.config.ts eslint.config.js tsconfig.json worker.js wrangler.jsonc pnpm-workspace.yaml .prettierrc.json",
    "typecheck": "astro check && tsc --noEmit",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm build",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:dry": "pnpm build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "astro": "^7.1.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.1",
    "@typescript-eslint/parser": "^8.65.0",
    "clsx": "^2.1.1",
    "eslint": "^10.8.0",
    "eslint-plugin-astro": "^3.0.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "wrangler": "^4.114.0"
  }
}
